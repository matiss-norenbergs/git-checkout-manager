<Window x:Class="GitCheckoutManager.Views.LocalChangesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Local changes"
        Width="820" Height="620"
        MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <DataTemplate x:Key="RowTemplate">
            <Grid Margin="0,1" ToolTip="{Binding ToolTip}" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Path}" FontFamily="Consolas" FontSize="12"
                           TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="{Binding Detail}" FontSize="11.5" Margin="0,0,10,0"
                               Foreground="{DynamicResource MutedTextBrush}"/>
                    <TextBlock Text="{Binding Label}" FontSize="11.5" MinWidth="130"
                               Foreground="{DynamicResource MutedTextBrush}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="GroupTemplate">
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="{Binding Header}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource RowTemplate}" Margin="12,0,0,0"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding HeaderText}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding ErrorText}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource DangerBrush}"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="Read-only: this list only shows what git reports. Commit, stage or discard changes in your Git tool."
                       Margin="0,4,0,0" TextWrapping="Wrap" FontSize="11.5"
                       Foreground="{DynamicResource MutedTextBrush}"/>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,10,0,0" Padding="10,8"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Groups}" ItemTemplate="{StaticResource GroupTemplate}"/>
                    <TextBlock Text="{Binding MoreText}" FontStyle="Italic"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Visibility="{Binding HasMore, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="No local changes." Foreground="{DynamicResource MutedTextBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Refresh" Style="{StaticResource ActionButton}" Width="90"
                    Command="{Binding RefreshCommand}"/>
            <Button Content="Close" Style="{StaticResource AccentActionButton}" Width="90" Margin="0"
                    IsCancel="True" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>

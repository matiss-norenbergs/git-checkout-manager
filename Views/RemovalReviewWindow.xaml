<Window x:Class="GitSparseManager.Views.RemovalReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review removal"
        Width="760" Height="620"
        MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="SectionToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Chevron" Text="&#x25B6;" FontSize="9"
                                           VerticalAlignment="Center" Margin="0,0,6,0"
                                           Foreground="{TemplateBinding Foreground}"/>
                                <ContentPresenter VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chevron" Property="Text" Value="&#x25BC;"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="PathItemTemplate">
            <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource MutedTextBrush}"/>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: folders that will go away -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="These folders will be removed from your checkout:"
                       FontWeight="SemiBold" TextWrapping="Wrap"/>
            <Border Margin="0,8,0,0" Padding="8,6"
                    Background="{DynamicResource SubPanelBackgroundBrush}"
                    BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
                <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="RemovedFoldersList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12"
                                           Foreground="{DynamicResource WindowForegroundBrush}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </StackPanel>

        <!-- One section per non-empty group -->
        <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <Border x:Name="IgnoredSection" Margin="0,0,0,8" Padding="10,8"
                        Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <Grid>
                            <ToggleButton x:Name="IgnoredToggle" Style="{StaticResource SectionToggle}">
                                <TextBlock x:Name="IgnoredHeader" FontWeight="SemiBold"/>
                            </ToggleButton>
                            <CheckBox x:Name="IgnoredDelete" Content="Delete these"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <ScrollViewer MaxHeight="170" Margin="15,6,0,0" VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding IsChecked, ElementName=IgnoredToggle, Converter={StaticResource BoolToVis}}">
                            <ItemsControl x:Name="IgnoredItems" ItemTemplate="{StaticResource PathItemTemplate}"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <Border x:Name="UntrackedSection" Margin="0,0,0,8" Padding="10,8"
                        Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <Grid>
                            <ToggleButton x:Name="UntrackedToggle" Style="{StaticResource SectionToggle}">
                                <TextBlock x:Name="UntrackedHeader" FontWeight="SemiBold"/>
                            </ToggleButton>
                            <CheckBox x:Name="UntrackedDelete" Content="Delete these"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <ScrollViewer MaxHeight="170" Margin="15,6,0,0" VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding IsChecked, ElementName=UntrackedToggle, Converter={StaticResource BoolToVis}}">
                            <ItemsControl x:Name="UntrackedItems" ItemTemplate="{StaticResource PathItemTemplate}"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <Border x:Name="ChangedSection" Margin="0,0,0,8" Padding="10,8"
                        Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <Grid>
                            <ToggleButton x:Name="ChangedToggle" Style="{StaticResource SectionToggle}">
                                <TextBlock x:Name="ChangedHeader" FontWeight="SemiBold"
                                           Foreground="{DynamicResource DangerBrush}"/>
                            </ToggleButton>
                            <CheckBox x:Name="ChangedDelete" Content="Delete these"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <ScrollViewer MaxHeight="170" Margin="15,6,0,0" VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding IsChecked, ElementName=ChangedToggle, Converter={StaticResource BoolToVis}}">
                            <ItemsControl x:Name="ChangedItems" ItemTemplate="{StaticResource PathItemTemplate}"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="2" Margin="0,4,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource MutedTextBrush}">
            <Run Text="Files you keep stay on disk, so their folders will remain partly present."/>
            <LineBreak/>
            <Run Text="Tip: commit your changes first. Committed work stays in git history after the folder is removed."/>
        </TextBlock>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="ApplyButton" Content="Apply" Width="90" Padding="10,5"
                    IsDefault="True" Margin="0,0,8,0" Click="ApplyButton_Click"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="90" Padding="10,5"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>

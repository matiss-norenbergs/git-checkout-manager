<Window x:Class="GitCheckoutManager.Views.MessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="480" SizeToContent="Height"
        MinWidth="360" MaxHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="MessageText" Grid.Row="0" TextWrapping="Wrap"/>

        <TextBox x:Name="DetailsBox" Grid.Row="1" Margin="0,10,0,0"
                 IsReadOnly="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"
                 MaxHeight="220" Visibility="Collapsed"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 Background="{DynamicResource SubPanelBackgroundBrush}"
                 Foreground="{DynamicResource WindowForegroundBrush}"
                 BorderBrush="{DynamicResource PanelBorderBrush}"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="PrimaryButton" MinWidth="90" Padding="10,5" Margin="0,0,8,0"
                    IsDefault="True" Click="PrimaryButton_Click"/>
            <Button x:Name="MiddleButton" MinWidth="90" Padding="10,5" Margin="0,0,8,0"
                    Visibility="Collapsed" Click="MiddleButton_Click"/>
            <Button x:Name="SecondaryButton" Content="No" MinWidth="90" Padding="10,5"
                    IsCancel="True" Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</Window>

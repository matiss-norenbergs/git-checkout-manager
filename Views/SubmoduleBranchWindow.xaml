<Window x:Class="GitCheckoutManager.Views.SubmoduleBranchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Switch branch"
        Width="460" Height="480"
        MinWidth="360" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="HeaderText" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="CurrentText" Margin="0,4,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedTextBrush}"/>
            <TextBlock x:Name="HintText" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                       Foreground="{DynamicResource MutedTextBrush}"/>
            <TextBox x:Name="FilterBox" Margin="0,12,0,0" Padding="4,3" IsEnabled="False"
                     ToolTip="Filter branches" TextChanged="FilterBox_TextChanged"/>
            <CheckBox x:Name="ShowMissingCheck" Margin="0,8,0,0" Visibility="Collapsed"
                      Content="Show branches missing from some submodules"
                      Checked="ShowMissingCheck_Changed" Unchecked="ShowMissingCheck_Changed"/>
        </StackPanel>

        <ListBox x:Name="BranchList" Grid.Row="1" Margin="0,8,0,0"
                 Background="{DynamicResource SubPanelBackgroundBrush}"
                 Foreground="{DynamicResource WindowForegroundBrush}"
                 BorderBrush="{DynamicResource PanelBorderBrush}"
                 SelectionChanged="BranchList_SelectionChanged"
                 MouseDoubleClick="BranchList_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Label}" FontWeight="{Binding Weight}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,8,0,0" TextWrapping="Wrap" MinHeight="18"
                   Foreground="{DynamicResource MutedTextBrush}"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="SwitchButton" Content="Switch" Padding="10,5" Margin="0,0,8,0"
                    MinWidth="90" IsDefault="True" IsEnabled="False" Click="SwitchButton_Click"/>
            <Button Content="Cancel" Width="90" Padding="10,5" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>

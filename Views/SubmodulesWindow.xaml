<Window x:Class="GitSparseManager.Views.SubmodulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GitSparseManager.Views"
        Title="Submodules"
        Width="900" Height="500"
        MinWidth="640" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <views:ResourceBrushConverter x:Key="ResourceBrush"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top: summary and filters -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding SummaryText}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding LoadError}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource DangerBrush}"
                       Visibility="{Binding HasLoadError, Converter={StaticResource BoolToVis}}"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <CheckBox Content="Show only problems" Margin="0,0,20,0"
                          IsChecked="{Binding ShowOnlyProblems}"/>
                <CheckBox Content="Show submodules outside my checkout"
                          IsChecked="{Binding ShowOutsideCheckout}"/>
            </StackPanel>
        </StackPanel>

        <!-- Rows -->
        <Border Grid.Row="1" Margin="0,12,0,0"
                Background="{DynamicResource SubPanelBackgroundBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,8" BorderThickness="0,0,0,1"
                                        BorderBrush="{DynamicResource PanelBorderBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="2*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Reserved for a later action; nothing acts on it yet -->
                                        <CheckBox Grid.Column="0" IsEnabled="False" VerticalAlignment="Top"/>

                                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Path}" FontFamily="Consolas"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
                                            <TextBlock Text="{Binding Name}" FontSize="11.5"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource MutedTextBrush}"/>
                                            <TextBlock Text="{Binding Error}" FontSize="11.5" TextWrapping="Wrap"
                                                       Margin="0,2,0,0"
                                                       Foreground="{DynamicResource DangerBrush}"
                                                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding StateText}"
                                                   FontWeight="SemiBold" TextWrapping="Wrap"
                                                   Margin="0,0,12,0" VerticalAlignment="Top"
                                                   ToolTip="{Binding StateToolTip}"
                                                   Foreground="{Binding StateBrushKey, Converter={StaticResource ResourceBrush}}"/>

                                        <StackPanel Grid.Column="3" Margin="0,0,12,0">
                                            <TextBlock FontFamily="Consolas" FontSize="12">
                                                <Run Text="pinned  " Foreground="{DynamicResource MutedTextBrush}"/><Run Text="{Binding PinnedShortSha, Mode=OneTime}"/>
                                            </TextBlock>
                                            <TextBlock FontFamily="Consolas" FontSize="12">
                                                <Run Text="current " Foreground="{DynamicResource MutedTextBrush}"/><Run Text="{Binding CurrentShortSha, Mode=OneTime}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="{Binding Url}" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Url}"/>
                                            <TextBlock Text="{Binding BranchText}"
                                                       FontSize="11.5" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource MutedTextBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Text="{Binding EmptyText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Visibility="{Binding HasEmptyText, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Border>

        <!-- Bottom -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Refresh" Width="90" Padding="10,5" Margin="0,0,8,0"
                    Command="{Binding RefreshCommand}"/>
            <Button Content="Close" Width="90" Padding="10,5" IsDefault="True" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>

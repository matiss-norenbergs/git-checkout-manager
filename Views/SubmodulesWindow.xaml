<Window x:Class="GitCheckoutManager.Views.SubmodulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GitCheckoutManager.Views"
        Title="Submodules"
        Width="900" Height="560"
        MinWidth="640" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <views:ResourceBrushConverter x:Key="ResourceBrush"/>

        <!-- Looks like a link, behaves like a button -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="Label" Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Label" Property="TextDecorations" Value="Underline"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Label" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top: summary and filters -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding SummaryText}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding LoadError}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource DangerBrush}"
                       Visibility="{Binding HasLoadError, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{Binding ResultText}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Visibility="{Binding HasResultText, Converter={StaticResource BoolToVis}}"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <CheckBox Content="Show only problems" Margin="0,0,20,0"
                          IsChecked="{Binding ShowOnlyProblems}"/>
                <CheckBox Content="Show submodules outside my checkout" Margin="0,0,20,0"
                          IsChecked="{Binding ShowOutsideCheckout}"/>
                <Button Content="Select all with problems" Style="{StaticResource LinkButton}"
                        VerticalAlignment="Center"
                        Command="{Binding SelectAllWithProblemsCommand}"/>
            </StackPanel>
        </StackPanel>

        <!-- Rows -->
        <Border Grid.Row="1" Margin="0,12,0,0"
                Background="{DynamicResource SubPanelBackgroundBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,8" BorderThickness="0,0,0,1"
                                        BorderBrush="{DynamicResource PanelBorderBrush}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="2*"/>
                                            <!-- Fixed, so rows without actions keep the same width and every column lines up -->
                                            <ColumnDefinition Width="36"/>
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" VerticalAlignment="Top"
                                                  IsChecked="{Binding IsSelected}"
                                                  IsEnabled="{Binding IsSelectable}"
                                                  ToolTip="{Binding SelectToolTip}"
                                                  ToolTipService.ShowOnDisabled="True"/>

                                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Path}" FontFamily="Consolas"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
                                            <TextBlock Text="{Binding Name}" FontSize="11.5"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource MutedTextBrush}"/>
                                        </StackPanel>

                                        <!-- Full row width, left-aligned with the path text -->
                                        <Expander Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="5"
                                                  Header="Error details" FontWeight="SemiBold" FontSize="12"
                                                  Margin="0,6,0,0"
                                                  Style="{StaticResource SectionExpander}"
                                                  Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                                            <TextBox Text="{Binding Error, Mode=OneWay}" IsReadOnly="True"
                                                     TextWrapping="NoWrap" FontFamily="Consolas" FontSize="11.5"
                                                     FontWeight="Normal" MaxHeight="160" Margin="0,4,0,0"
                                                     VerticalScrollBarVisibility="Auto"
                                                     HorizontalScrollBarVisibility="Auto"
                                                     Background="{DynamicResource WindowBackgroundBrush}"
                                                     Foreground="{DynamicResource WindowForegroundBrush}"/>
                                        </Expander>

                                        <StackPanel Grid.Column="2" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding DisplayStateText}"
                                                       FontWeight="SemiBold" TextWrapping="Wrap"
                                                       ToolTip="{Binding StateToolTip}"
                                                       Foreground="{Binding DisplayBrushKey, Converter={StaticResource ResourceBrush}}"/>
                                            <TextBlock Text="{Binding StateText}" FontSize="11.5" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       Visibility="{Binding ShowUnderlyingState, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" Margin="0,0,12,0">
                                            <TextBlock FontFamily="Consolas" FontSize="12">
                                                <Run Text="pinned  " Foreground="{DynamicResource MutedTextBrush}"/><Run Text="{Binding PinnedShortSha, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock FontFamily="Consolas" FontSize="12">
                                                <Run Text="current " Foreground="{DynamicResource MutedTextBrush}"/><Run Text="{Binding CurrentShortSha, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="{Binding DisplayUrl}" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding DisplayUrl}"/>
                                            <TextBlock Text="{Binding BranchText}"
                                                       FontSize="11.5" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource MutedTextBrush}"/>
                                            <TextBlock Text="{Binding OverrideText}" FontSize="11.5"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding OverrideToolTip}"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       Visibility="{Binding UrlOverridden, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>

                                        <!-- Row actions. The menu reaches the window's view model through the button's Tag. -->
                                        <Button Grid.Column="5" Content="&#x22EF;" Width="28" Padding="0,0,0,2"
                                                VerticalAlignment="Top" Margin="8,0,0,0" ToolTip="Actions"
                                                IsEnabled="{Binding ActionsEnabled}"
                                                Visibility="{Binding HasActions, Converter={StaticResource BoolToVis}}"
                                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Click="ActionsButton_Click">
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Set URL…"
                                                              Visibility="{Binding CanSetUrl, Converter={StaticResource BoolToVis}}"
                                                              Command="{Binding PlacementTarget.Tag.SetUrlCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding}"/>
                                                    <MenuItem Header="Reset URL"
                                                              Visibility="{Binding CanResetUrl, Converter={StaticResource BoolToVis}}"
                                                              Command="{Binding PlacementTarget.Tag.ResetUrlCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding}"/>
                                                    <MenuItem Header="Clone manually…"
                                                              Visibility="{Binding CanCloneManually, Converter={StaticResource BoolToVis}}"
                                                              Command="{Binding PlacementTarget.Tag.CloneManuallyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding}"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Text="{Binding EmptyText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Visibility="{Binding HasEmptyText, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Border>

        <!-- Bottom: options on the left, actions on the right -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Bottom"
                        IsEnabled="{Binding IsIdle}">
                <RadioButton GroupName="SubmoduleTarget" Margin="0,0,0,4"
                             Content="Pinned commit (what the main repo expects)"
                             IsChecked="{Binding UsePinned}"/>
                <RadioButton GroupName="SubmoduleTarget" Margin="0,0,0,4"
                             Content="Latest from branch (--remote)"
                             IsChecked="{Binding LatestFromBranch}"/>
                <CheckBox Content="Include nested submodules (--recursive)"
                          IsChecked="{Binding IncludeNested}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="Initialize selected" Style="{StaticResource AccentActionButton}"
                        Command="{Binding InitializeSelectedCommand}"/>
                <Button Content="Cancel" Width="90" Padding="10,5" Margin="0,0,8,0"
                        Command="{Binding CancelRunCommand}"
                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
                <Button Content="Refresh" Width="90" Padding="10,5" Margin="0,0,8,0"
                        Command="{Binding RefreshCommand}"/>
                <Button Content="Close" Width="90" Padding="10,5" IsDefault="True" IsCancel="True"
                        IsEnabled="{Binding IsIdle}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

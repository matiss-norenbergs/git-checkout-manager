<Window x:Class="GitCheckoutManager.Views.SubmodulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GitCheckoutManager.Views"
        xmlns:models="clr-namespace:GitCheckoutManager.Models"
        xmlns:controls="clr-namespace:GitCheckoutManager.Controls"
        Title="Submodules"
        Width="1400" Height="820"
        MinWidth="640" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <views:ResourceBrushConverter x:Key="ResourceBrush"/>
        <views:EnumToBoolConverter x:Key="EnumToBool"/>

    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top: summary and filters -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding SummaryText}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding LoadError}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource DangerBrush}"
                       Visibility="{Binding HasLoadError, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{Binding ResultText}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Visibility="{Binding HasResultText, Converter={StaticResource BoolToVis}}"/>
            <!-- Filters on the left (they wrap at narrow widths); the selection actions stay at the right end -->
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,2,20,2" VerticalAlignment="Center">
                        <Grid>
                            <TextBox x:Name="SearchBox" Width="260" Padding="5,4" VerticalAlignment="Center"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                     PreviewKeyDown="SearchBox_PreviewKeyDown"
                                     ToolTip="Matches the path or name. Separate several terms with commas. Ctrl+F focuses this box; Esc clears it."/>
                            <TextBlock Text="Filter by path… (comma for several)" IsHitTestVisible="False"
                                       Margin="8,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource MutedTextBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text.Length, ElementName=SearchBox}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <TextBlock Text="{Binding SearchCountText}" Margin="8,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Visibility="{Binding HasSearchCountText, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <CheckBox Content="Show only problems" Margin="0,2,20,2" VerticalAlignment="Center"
                              IsChecked="{Binding ShowOnlyProblems}"/>
                    <CheckBox Content="Show submodules outside my checkout" Margin="0,2,20,2" VerticalAlignment="Center"
                              IsChecked="{Binding ShowOutsideCheckout}"/>
                    <Button Content="Select all with problems" Style="{StaticResource LinkButton}"
                            VerticalAlignment="Center" Margin="0,2,20,2"
                            Command="{Binding SelectAllWithProblemsCommand}"/>
                </WrapPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedText}" VerticalAlignment="Center" Margin="0,0,10,0"
                               Foreground="{DynamicResource MutedTextBrush}"/>
                    <Button Content="{Binding PullButtonText}" Style="{StaticResource ActionButton}" Padding="10,4"
                            Margin="0,0,6,0" ToolTip="{Binding PullToolTip}"
                            ToolTipService.ShowOnDisabled="True"
                            Command="{Binding PullSelectedCommand}"/>
                    <Button Content="{Binding SwitchButtonText}" Style="{StaticResource ActionButton}" Padding="10,4"
                            Margin="0,0,6,0" ToolTip="{Binding SwitchToolTip}"
                            ToolTipService.ShowOnDisabled="True"
                            Command="{Binding SwitchSelectedCommand}"/>
                    <Button Content="&#x22EF;" Width="28" Padding="0,0,0,2" ToolTip="More selection actions"
                            Tag="{Binding}" Click="ActionsButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <ContextMenu.Resources>
                                    <Style x:Key="ResetTip" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                        <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="ToolTip" Value="Tick submodules that are off their recorded commit first."/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                    <Style x:Key="RemoteTip" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                        <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="ToolTip" Value="Tick one or more submodules that share the same remote first."/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContextMenu.Resources>
                                <MenuItem Header="Reset selected to recorded commit"
                                          Style="{StaticResource ResetTip}"
                                          Command="{Binding PlacementTarget.Tag.ResetSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="Select all with this remote"
                                          Style="{StaticResource RemoteTip}"
                                          Command="{Binding PlacementTarget.Tag.SelectAllWithRemoteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- Rows -->
        <Border Grid.Row="1" Margin="0,12,0,0"
                Background="{DynamicResource SubPanelBackgroundBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Column header: same columns and padding as the row template; the gutter on the right takes the
                     vertical scrollbar's width (set from the ScrollViewer) so the labels stay aligned. -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Padding="10,6" BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource PanelBorderBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <controls:TreeCheckBox Grid.Column="0" VerticalAlignment="Center"
                                                   Style="{StaticResource {x:Type CheckBox}}"
                                                   IsChecked="{Binding HeaderSelectAll}"
                                                   IsEnabled="{Binding HeaderSelectAllEnabled}"
                                                   ToolTip="{Binding HeaderSelectAllToolTip}"/>
                            <TextBlock Grid.Column="1" Text="Path" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MutedTextBrush}"/>
                            <TextBlock Grid.Column="2" Text="State" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MutedTextBrush}"/>
                            <TextBlock Grid.Column="3" Text="Commits" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MutedTextBrush}"/>
                            <TextBlock Grid.Column="4" Text="URL" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MutedTextBrush}"/>
                        </Grid>
                    </Border>
                    <Border x:Name="HeaderGutter" Grid.Column="1" Width="0"
                            BorderThickness="0,0,0,1" BorderBrush="{DynamicResource PanelBorderBrush}"/>
                </Grid>

                <ScrollViewer x:Name="RowsScroll" Grid.Row="1"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              ScrollChanged="RowsScroll_Changed" SizeChanged="RowsScroll_Changed"
                              FocusVisualStyle="{x:Null}">
                    <ItemsControl ItemsSource="{Binding Rows}" FocusVisualStyle="{x:Null}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,8" BorderThickness="0,0,0,1"
                                        BorderBrush="{DynamicResource PanelBorderBrush}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="1*"/>
                                            <!-- Fixed, so rows without actions keep the same width and every column lines up -->
                                            <ColumnDefinition Width="36"/>
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" VerticalAlignment="Top"
                                                  IsChecked="{Binding IsSelected}"
                                                  IsEnabled="{Binding IsSelectable}"
                                                  ToolTip="{Binding SelectToolTip}"
                                                  ToolTipService.ShowOnDisabled="True"/>

                                        <StackPanel Grid.Column="1" Margin="{Binding PathMargin}">
                                            <TextBlock Text="{Binding DisplayPath}" FontFamily="Consolas"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayPath}"/>
                                            <TextBlock Text="{Binding Name}" FontSize="11.5"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource MutedTextBrush}"/>
                                        </StackPanel>

                                        <!-- Full row width, left-aligned with the path text -->
                                        <Expander Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="5"
                                                  Header="Error details" FontWeight="SemiBold" FontSize="12"
                                                  Margin="{Binding ErrorMargin}"
                                                  Style="{StaticResource SectionExpander}"
                                                  Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                                            <TextBox Text="{Binding Error, Mode=OneWay}" IsReadOnly="True"
                                                     TextWrapping="NoWrap" FontFamily="Consolas" FontSize="11.5"
                                                     FontWeight="Normal" MaxHeight="160" Margin="0,4,0,0"
                                                     VerticalScrollBarVisibility="Auto"
                                                     HorizontalScrollBarVisibility="Auto"
                                                     Background="{DynamicResource WindowBackgroundBrush}"
                                                     Foreground="{DynamicResource WindowForegroundBrush}"/>
                                        </Expander>

                                        <!-- Moved note: own row under State, Commits and URL; single line, full text in the tooltip -->
                                        <TextBlock Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="3" Margin="0,4,0,0"
                                                   Text="{Binding MovedNoteText}" FontSize="11.5"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding MovedNoteText}"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   Visibility="{Binding ShowMovedNote, Converter={StaticResource BoolToVis}}"/>

                                        <StackPanel Grid.Column="2" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding DisplayStateText}"
                                                       FontWeight="SemiBold" TextWrapping="Wrap"
                                                       ToolTip="{Binding StateToolTip}"
                                                       Foreground="{Binding DisplayBrushKey, Converter={StaticResource ResourceBrush}}"/>
                                            <TextBlock Text="{Binding StateText}" FontSize="11.5" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       Visibility="{Binding ShowUnderlyingState, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" Margin="0,0,12,0">
                                            <TextBlock FontFamily="Consolas" FontSize="12">
                                                <Run Text="pinned  " Foreground="{DynamicResource MutedTextBrush}"/><Run Text="{Binding PinnedShortSha, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock FontFamily="Consolas" FontSize="12">
                                                <Run Text="current " Foreground="{DynamicResource MutedTextBrush}"/><Run Text="{Binding CurrentShortSha, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding BranchLineText}" FontSize="11.5" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       Visibility="{Binding HasBranchLine, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="{Binding DisplayUrl}" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding DisplayUrl}"/>
                                            <TextBlock Text="{Binding BranchText}"
                                                       FontSize="11.5" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource MutedTextBrush}"/>
                                            <TextBlock Text="{Binding OverrideText}" FontSize="11.5"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding OverrideToolTip}"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       Visibility="{Binding UrlOverridden, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>

                                        <!-- Row actions. The menu reaches the window's view model through the button's Tag. -->
                                        <Button Grid.Column="5" Content="&#x22EF;" Width="28" Padding="0,0,0,2"
                                                VerticalAlignment="Top" Margin="8,0,0,0" ToolTip="Actions"
                                                IsEnabled="{Binding ActionsEnabled}"
                                                Visibility="{Binding HasActions, Converter={StaticResource BoolToVis}}"
                                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Click="ActionsButton_Click">
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Open in Explorer"
                                                              Visibility="{Binding CanOpen, Converter={StaticResource BoolToVis}}"
                                                              Command="{Binding PlacementTarget.Tag.OpenInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding}"/>
                                                    <MenuItem Header="Open in VS Code"
                                                              Visibility="{Binding CanOpenInVsCode, Converter={StaticResource BoolToVis}}"
                                                              Command="{Binding PlacementTarget.Tag.OpenInVsCodeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding}"/>
                                                    <MenuItem Header="Set URL…"
                                                              Visibility="{Binding CanSetUrl, Converter={StaticResource BoolToVis}}"
                                                              Command="{Binding PlacementTarget.Tag.SetUrlCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding}"/>
                                                    <MenuItem Header="Reset URL"
                                                              Visibility="{Binding CanResetUrl, Converter={StaticResource BoolToVis}}"
                                                              Command="{Binding PlacementTarget.Tag.ResetUrlCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding}"/>
                                                    <MenuItem Header="Clone manually…"
                                                              Visibility="{Binding CanCloneManually, Converter={StaticResource BoolToVis}}"
                                                              Command="{Binding PlacementTarget.Tag.CloneManuallyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding}"/>
                                                    <MenuItem Header="Switch branch…"
                                                              Visibility="{Binding CanSwitchBranch, Converter={StaticResource BoolToVis}}"
                                                              Command="{Binding PlacementTarget.Tag.SwitchBranchCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding}"/>
                                                    <MenuItem Header="Reset to recorded commit"
                                                              Visibility="{Binding CanResetToRecorded, Converter={StaticResource BoolToVis}}"
                                                              Command="{Binding PlacementTarget.Tag.ResetToRecordedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding}"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Grid.Row="1" Text="{Binding EmptyText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Visibility="{Binding HasEmptyText, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Border>

        <!-- Bottom: options on the left, actions on the right -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Bottom"
                        IsEnabled="{Binding IsIdle}">
                <!-- No GroupName: both radios bind to Target, and radios sharing a parent panel already group. -->
                <RadioButton Margin="0,0,0,4"
                             Content="Pinned commit (what the main repo expects)"
                             IsChecked="{Binding Target, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:SubmoduleTarget.Pinned}}"/>
                <RadioButton Margin="0,0,0,4"
                             Content="Latest from branch (--remote)"
                             IsChecked="{Binding Target, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:SubmoduleTarget.LatestFromBranch}}"/>
                <CheckBox Content="Include nested submodules (--recursive)"
                          IsChecked="{Binding IncludeNested}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="Copy report" Width="110" Padding="10,5" Margin="0,0,8,0"
                        ToolTip="Copies a plain-text list of the problem submodules, to send to the repository maintainer"
                        Command="{Binding CopyReportCommand}"/>
                <Button Content="{Binding InitializeButtonText}" Style="{StaticResource AccentActionButton}"
                        Command="{Binding InitializeSelectedCommand}"/>
                <Button Content="Cancel" Width="90" Padding="10,5" Margin="0,0,8,0"
                        Command="{Binding CancelRunCommand}"
                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
                <Button Content="Refresh" Width="90" Padding="10,5" Margin="0,0,8,0"
                        Command="{Binding RefreshCommand}"/>
                <Button Content="Close" Width="90" Padding="10,5" IsDefault="True" IsCancel="True"
                        IsEnabled="{Binding IsIdle}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

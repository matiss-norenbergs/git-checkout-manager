<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>GitCheckoutManager</RootNamespace>
    <AssemblyName>GitCheckoutManager</AssemblyName>
    <Product>Git Checkout Manager</Product>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>2.4.1</Version>
    <StartupObject>GitCheckoutManager.App</StartupObject>
  </PropertyGroup>

  <!-- App.xaml is a plain Page so the build doesn't generate its own Main; see App.Main (Velopack must run first). -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <!-- The test project lives in a sub-folder; keep its sources out of the app's default globs. -->
  <ItemGroup>
    <Compile Remove="GitCheckoutManager.Tests\**" />
    <EmbeddedResource Remove="GitCheckoutManager.Tests\**" />
    <None Remove="GitCheckoutManager.Tests\**" />
    <Page Remove="GitCheckoutManager.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

</Project>

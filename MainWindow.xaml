<Window x:Class="GitSparseManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Git Sparse Checkout Manager" Icon="Assets/app.ico" Height="760" Width="1220"
        MinHeight="600" MinWidth="900">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Tab-strip RadioButton style -->
        <Style x:Key="TabRadioButton" TargetType="RadioButton">
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Margin" Value="0,0,1,0"/>
            <Setter Property="Background" Value="{x:Static Brushes.Transparent}"/>
            <Setter Property="BorderBrush" Value="{x:Static Brushes.Transparent}"/>
            <Setter Property="BorderThickness" Value="1,1,1,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabCheckedBackgroundBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TabCheckedBorderBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabHoverBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tree item style – applies recursively through HierarchicalDataTemplate -->
        <Style x:Key="TreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVis}}"/>
        </Style>

        <!-- Folder name bold, file name normal -->
        <Style x:Key="NodeNameStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Text" Value="{Binding Name}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerActionButton" TargetType="Button" BasedOn="{StaticResource ColoredActionButtonBase}">
            <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}"/>
        </Style>

        <Style x:Key="SuccessActionButton" TargetType="Button" BasedOn="{StaticResource ColoredActionButtonBase}">
            <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorderBrush}"/>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- ═══ UPDATE BAR ═════════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Top" Visibility="{Binding IsUpdateBarVisible, Converter={StaticResource BoolToVis}}"
                Background="{DynamicResource AccentBrush}" Padding="12,6">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Later" Command="{Binding DismissUpdateCommand}"
                        Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="8,0,0,0"
                        Foreground="{DynamicResource OnAccentBrush}" VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right" Content="Restart" Command="{Binding RestartToUpdateCommand}"
                        Padding="14,3" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding UpdateMessage}" VerticalAlignment="Center"
                           Foreground="{DynamicResource OnAccentBrush}"/>
            </DockPanel>
        </Border>

        <!-- ═══ MODE TABS ══════════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Top"
            Background="{DynamicResource TabStripBackgroundBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,0,0,1"
                Padding="4,0,0,0">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <RadioButton Content="Clone" GroupName="AppMode"
                                 IsChecked="{Binding IsCloneMode, Mode=TwoWay}"
                                 Style="{StaticResource TabRadioButton}"/>
                    <RadioButton Content="Manage Checkout" GroupName="AppMode"
                                 IsChecked="{Binding IsManageMode, Mode=TwoWay}"
                                 Style="{StaticResource TabRadioButton}"/>
                </StackPanel>

                <Button DockPanel.Dock="Right" Content="&#x2699;"
                        Command="{Binding OpenSettingsCommand}"
                        Style="{StaticResource ActionButton}"
                        FontFamily="Segoe UI Symbol" FontSize="15"
                        Padding="9,1" Margin="12,3,8,3" VerticalAlignment="Center"
                        ToolTip="Settings"/>
            </DockPanel>
        </Border>

        <!-- ═══ TOP: CONNECTION BAR ══════════════════════════════════════════ -->
        <Border DockPanel.Dock="Top"
            Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,0,0,1"
                Padding="10,7"
                Visibility="{Binding IsCloneMode, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Host:" VerticalAlignment="Center"
                           FontWeight="SemiBold" Margin="0,0,6,0"/>
                <ComboBox Grid.Column="1" MinWidth="90" VerticalAlignment="Center" Padding="5,4"
                          ItemsSource="{Binding HostTypes}"
                          SelectedItem="{Binding SelectedHostType}"/>

                <TextBlock Grid.Column="3" Text="Server URL:" VerticalAlignment="Center"
                           FontWeight="SemiBold" Margin="0,0,6,0"/>
                <TextBox Grid.Column="4"
                         Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Center" Padding="5,4"/>

                <TextBlock Grid.Column="6" Text="Personal Access Token:" VerticalAlignment="Center"
                           FontWeight="SemiBold" Margin="0,0,6,0"/>
                <PasswordBox Grid.Column="7" x:Name="TokenBox" VerticalAlignment="Center"
                             Padding="5,4" PasswordChanged="TokenBox_PasswordChanged"/>

                <StackPanel Grid.Column="8" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,12,0">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource DangerBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock VerticalAlignment="Center" FontSize="11.5">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Not connected"/>
                                <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Text" Value="Connected"/>
                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <Button Grid.Column="9" Content="Connect"
                        Command="{Binding ConnectCommand}"
                        Style="{StaticResource AccentActionButton}"
                        Margin="0"/>
            </Grid>
        </Border>

        <!-- ═══ SOURCE BAR: REPOSITORY / BRANCH ═══════════════════════════════ -->
        <Border DockPanel.Dock="Top"
            Background="{DynamicResource SubPanelBackgroundBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,0,0,1"
                Padding="10,7" IsEnabled="{Binding IsConnected}"
                Visibility="{Binding IsCloneMode, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Repository:" VerticalAlignment="Center"
                           FontWeight="SemiBold" Margin="0,0,6,0"/>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding RepositoriesView}"
                          SelectedItem="{Binding SelectedRepository}"
                          DisplayMemberPath="PathWithNamespace"
                          IsEditable="True"
                          IsTextSearchEnabled="False"
                          Text="{Binding RepositoryFilterText, UpdateSourceTrigger=PropertyChanged}"
                          VerticalAlignment="Center" Padding="5,3"/>

                <TextBlock Grid.Column="3" Text="Branch:" VerticalAlignment="Center"
                           FontWeight="SemiBold" Margin="0,0,6,0"/>
                <ComboBox Grid.Column="4"
                          ItemsSource="{Binding BranchesView}"
                          SelectedItem="{Binding SelectedBranch}"
                          DisplayMemberPath="Name"
                          IsEditable="True"
                          IsTextSearchEnabled="False"
                          Text="{Binding BranchFilterText, UpdateSourceTrigger=PropertyChanged}"
                          VerticalAlignment="Center" Padding="5,3"/>

                <Button Grid.Column="6" Content="Refresh tree"
                        Command="{Binding RefreshTreeCommand}"
                        Style="{StaticResource ActionButton}" Margin="0"
                        ToolTip="Re-fetch the folder structure from the server for the selected branch"/>
            </Grid>
        </Border>

        <!-- ═══ CHECKOUT BAR (Manage) ═════════════════════════════════════════ -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource PanelAltBackgroundBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,0,0,1"
                Padding="10,7"
                Visibility="{Binding IsManageMode, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Checkout:" VerticalAlignment="Center"
                               FontWeight="SemiBold" Margin="0,0,6,0"/>
                    <ComboBox Grid.Column="1"
                              x:Name="CheckoutCombo"
                              ItemsSource="{Binding RecentCheckouts}"
                              SelectedItem="{Binding SelectedRecentCheckout, Mode=TwoWay}"
                              DropDownOpened="CheckoutCombo_DropDownOpened"
                              SelectionChanged="CheckoutCombo_SelectionChanged"
                              VerticalAlignment="Center" Padding="5,3"
                              ToolTip="Recently opened Git checkouts">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <!-- Greyed out but still selectable, so the user can clean it up. -->
                                                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                                                    <Setter Property="Opacity" Value="0.6"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Button Grid.Column="3" Content="Browse…"
                            Command="{Binding BrowseCheckoutCommand}"
                            Style="{StaticResource ActionButton}" Margin="0"
                            ToolTip="Pick a folder inside a Git checkout"/>
                    <Button Grid.Column="5" Content="Reload"
                            Command="{Binding ReloadCheckoutCommand}"
                            Style="{StaticResource ActionButton}" Margin="0"
                            ToolTip="Re-read the current checkout from git"/>
                    <Button Grid.Column="7" Content="Submodules…"
                            Command="{Binding ShowSubmodulesCommand}"
                            Style="{StaticResource ActionButton}" Margin="0"
                            ToolTip="Show the submodules of this checkout and their state"/>
                </Grid>

                <TextBlock Text="{Binding CheckoutSummary}" Margin="0,6,0,0"
                           FontSize="11.5" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource MutedTextBrush}"
                           ToolTip="{Binding CheckoutSummary}"/>
            </StackPanel>
        </Border>

        <!-- ═══ BOTTOM: STATUS BAR ═══════════════════════════════════════════ -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource StatusBarBackgroundBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,1,0,0"
                Padding="10,4">
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" FontSize="11.5"/>
        </Border>

        <!-- ═══ BOTTOM: ACTION BUTTONS ═══════════════════════════════════════ -->
        <Border DockPanel.Dock="Bottom"
            Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,1,0,0"
                Padding="10,7" IsEnabled="{Binding IsOperationEnabled}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Secondary actions (left) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            Visibility="{Binding IsCloneMode, Converter={StaticResource BoolToVis}}">
                    <Button Content="Copy script"
                            Command="{Binding CopyScriptCommand}"
                            Style="{StaticResource ActionButton}"/>
                    <Button Content="Save .bat"
                            Command="{Binding SaveBatCommand}"
                            Style="{StaticResource ActionButton}"/>
                    <Button Content="Save .sh"
                            Command="{Binding SaveShCommand}"
                            Style="{StaticResource ActionButton}"/>
                </StackPanel>
                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            Visibility="{Binding IsManageMode, Converter={StaticResource BoolToVis}}">
                    <Button Content="Copy script"
                            Command="{Binding CopyScriptCommand}"
                            Style="{StaticResource ActionButton}"/>
                    <Button Content="Save .bat"
                            Command="{Binding SaveManageBatCommand}"
                            Style="{StaticResource ActionButton}"/>
                    <Button Content="Save .sh"
                            Command="{Binding SaveManageShCommand}"
                            Style="{StaticResource ActionButton}"/>
                </StackPanel>

                <!-- Primary action (right) -->
                <Button Grid.Column="1" Content="Execute Locally"
                        Command="{Binding ExecuteScriptCommand}"
                        Style="{StaticResource AccentActionButton}"
                        Margin="0"
                        Visibility="{Binding IsCloneMode, Converter={StaticResource BoolToVis}}"
                        ToolTip="Runs the generated batch script on this machine"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            Visibility="{Binding IsManageMode, Converter={StaticResource BoolToVis}}">
                    <Button Content="Retry cleanup"
                            Command="{Binding RetryCleanupCommand}"
                            Style="{StaticResource ActionButton}"
                            Visibility="{Binding HasCleanupLeftovers, Converter={StaticResource BoolToVis}}"
                            ToolTip="Close programs using these folders, then retry"/>
                    <Button Content="Disable sparse checkout"
                            Command="{Binding DisableSparseCheckoutCommand}"
                            Style="{StaticResource ActionButton}"
                            ToolTip="Checks out all files of the repository (may download them)"/>
                    <Button Content="Apply Now"
                            Command="{Binding ApplyManageCommand}"
                            Style="{StaticResource AccentActionButton}"
                            Margin="0"
                            ToolTip="Runs 'git sparse-checkout set' directly in the selected repository"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ BOTTOM: DESTINATION BAR (Clone) ═══════════════════════════════ -->
        <Border DockPanel.Dock="Bottom"
            Background="{DynamicResource SubPanelBackgroundBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,1,0,0"
                Padding="10,7" IsEnabled="{Binding IsConnected}"
                Visibility="{Binding IsCloneMode, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="200"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Clone into:" VerticalAlignment="Center"
                           FontWeight="SemiBold" Margin="0,0,8,0"/>
                <TextBox Grid.Row="0" Grid.Column="1"
                         Text="{Binding CloneParentFolder, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Center" Padding="5,4"
                         ToolTip="Folder in which the checkout folder is created"/>
                <Button Grid.Row="0" Grid.Column="2" Content="Browse…" Margin="6,0,0,0" Padding="10,4"
                        Command="{Binding BrowseCloneParentCommand}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Folder:" VerticalAlignment="Center"
                           FontWeight="SemiBold" Margin="0,4,8,0"/>
                <TextBox Grid.Row="1" Grid.Column="1"
                         Text="{Binding FolderName, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Center" Padding="5,4" Margin="0,4,0,0"
                         ToolTip="Name of the checkout folder. Generated from the pattern in Settings until you edit it."/>
                <Button Grid.Row="1" Grid.Column="2" Content="Auto" Margin="6,4,0,0" Padding="10,4"
                        Style="{StaticResource ActionButton}"
                        Command="{Binding ResetFolderNameCommand}"
                        ToolTip="Use automatic name"/>

                <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,3,0,0"
                           Text="{Binding DestinationPreview}" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding DestinationPreview}" FontSize="12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasDestinationError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="New Branch:" VerticalAlignment="Center"
                           FontWeight="SemiBold" Margin="0,8,8,0"
                           ToolTip="Optional: create and switch to this branch after sparse checkout"/>
                <TextBox Grid.Row="3" Grid.Column="1"
                         Text="{Binding NewBranchName, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Center" Padding="5,4" Margin="0,8,0,0"
                         ToolTip="Optional: appends 'git checkout -b &lt;name&gt;' to the generated script"/>
                <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,3,0,0" FontSize="12"
                           Text="{Binding NewBranchHint}" TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNewBranchInvalid}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="4" Orientation="Vertical"
                            VerticalAlignment="Top">
                    <CheckBox IsChecked="{Binding InitSubmodules}"
                              ToolTip="Appends 'git submodule update --init --remote --recursive' to the script. Note: --remote updates each submodule to the latest commit on its upstream tracking branch, not the pinned superproject commit.">
                        <TextBlock Text="Initialize submodules" FontSize="12"/>
                    </CheckBox>
                    <CheckBox IsChecked="{Binding KeepWindowOpen}"
                              Margin="0,6,0,0"
                              ToolTip="When enabled, the CMD window stays open after the script finishes so you can review output and errors. Disable to close automatically.">
                        <TextBlock Text="Keep CMD window open" FontSize="12"/>
                    </CheckBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ CENTRE: TREE | RIGHT PANEL ═══════════════════════════════════ -->
        <Grid>
            <Grid IsEnabled="{Binding IsOperationEnabled}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="320"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="380" MinWidth="260"/>
                </Grid.ColumnDefinitions>

                <!-- ── TREE PANEL ───────────────────────────────────────────── -->
                <DockPanel Grid.Column="0">
                    <!-- Search + presets -->
                    <Border DockPanel.Dock="Top"
                            Background="{DynamicResource SectionHeaderBackgroundBrush}"
                            BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,0,0,1"
                            Padding="8,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*" MinWidth="80"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Search:" VerticalAlignment="Center"
                                       FontWeight="SemiBold" Margin="0,0,6,0"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalAlignment="Center" Padding="5,4"/>

                            <StackPanel Grid.Column="3" Orientation="Horizontal">
                                <Grid Margin="0,0,6,0" VerticalAlignment="Center">
                                    <ComboBox ItemsSource="{Binding AvailablePresets}"
                                              SelectedItem="{Binding SelectedPreset}"
                                              DisplayMemberPath="Name"
                                              MinWidth="220"
                                              Padding="5,3"
                                              ToolTip="Saved presets for this repository"/>
                                    <!-- Placeholder; sits over the (empty) selection box, clicks pass through -->
                                    <TextBlock Text="Preset…" Margin="8,0,28,0"
                                               VerticalAlignment="Center" IsHitTestVisible="False"
                                               Foreground="{DynamicResource MutedTextBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedPreset}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <Button Content="Load"
                                        Command="{Binding LoadPresetCommand}"
                                        Style="{StaticResource ActionButton}"
                                        Padding="10,5" Margin="0,0,6,0"
                                        ToolTip="Apply this preset's saved paths to the tree"/>
                                <Button Content="Save…"
                                        Command="{Binding SavePresetCommand}"
                                        Style="{StaticResource ActionButton}"
                                        Padding="10,5" Margin="0,0,6,0"
                                        ToolTip="Save the current selection as a named preset"/>
                                <Button x:Name="PresetMenuButton" Content="&#x22EF;"
                                        Style="{StaticResource ActionButton}"
                                        Padding="8,5" Margin="0"
                                        Click="PresetMenuButton_Click"
                                        ToolTip="More preset actions">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Rename"
                                                      Command="{Binding RenamePresetCommand}"/>
                                            <MenuItem Header="Delete"
                                                      Command="{Binding DeletePresetCommand}"
                                                      Foreground="{DynamicResource DangerBrush}"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TreeView ItemsSource="{Binding TreeNodes}"
                              ItemContainerStyle="{StaticResource TreeItemStyle}"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}"
                                                      ItemContainerStyle="{StaticResource TreeItemStyle}">
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <!-- Only folders are selectable: cone mode cannot take a file path -->
                                    <CheckBox IsChecked="{Binding IsChecked}"
                                              IsThreeState="True"
                                              VerticalAlignment="Center"
                                              Margin="0,0,5,0">
                                        <CheckBox.Style>
                                            <Style TargetType="CheckBox">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFolder}" Value="False">
                                                        <Setter Property="Visibility" Value="Hidden"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </CheckBox.Style>
                                    </CheckBox>

                                    <!-- Node name: bold for folders, muted for excluded files -->
                                    <TextBlock VerticalAlignment="Center" Text="{Binding Name}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsFolder}" Value="False">
                                                        <Setter Property="ToolTip"
                                                                Value="Files can't be selected individually. Files directly inside a folder are included whenever that folder or one of its sub-folders is selected."/>
                                                    </DataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsFolder}" Value="False"/>
                                                            <Condition Binding="{Binding IsIncluded}" Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- Submodule marker -->
                                    <TextBlock VerticalAlignment="Center" Text=" (submodule)"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               Visibility="{Binding IsSubmodule, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>

                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                              Background="{DynamicResource SplitterBrush}"/>

                <!-- ── RIGHT PANEL ──────────────────────────────────────────── -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="80"/>
                        <RowDefinition x:Name="ScriptSplitterRow" Height="Auto"/>
                        <RowDefinition x:Name="ScriptRow" Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Selected paths (Clone) -->
                    <DockPanel Grid.Row="0"
                               Visibility="{Binding IsCloneMode, Converter={StaticResource BoolToVis}}">
                        <Border DockPanel.Dock="Top" Background="{DynamicResource SectionHeaderBackgroundBrush}" Padding="8,4">
                            <TextBlock Text="Selected Paths" FontWeight="SemiBold" FontSize="12"/>
                        </Border>
                        <Grid>
                            <TextBox Text="{Binding SelectedPathsText, Mode=OneWay}"
                                     IsReadOnly="True" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     FontFamily="Consolas" FontSize="11"
                                     Padding="8"/>
                            <TextBlock Text="Tick folders in the tree to include them"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextAlignment="Center" TextWrapping="Wrap" Margin="12"
                                       IsHitTestVisible="False"
                                       Foreground="{DynamicResource MutedTextBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPathsText}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DockPanel>

                    <!-- Pending changes (Manage) -->
                    <DockPanel Grid.Row="0"
                               Visibility="{Binding IsManageMode, Converter={StaticResource BoolToVis}}">
                        <Border DockPanel.Dock="Top" Background="{DynamicResource SectionHeaderBackgroundBrush}" Padding="8,4">
                            <TextBlock Text="Pending Changes" FontWeight="SemiBold" FontSize="12"/>
                        </Border>
                        <TextBox Text="{Binding PendingChangesText, Mode=OneWay}"
                                 IsReadOnly="True" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="11"
                                 Padding="8"/>
                    </DockPanel>

                    <GridSplitter x:Name="ScriptSplitter" Grid.Row="1" Height="5" HorizontalAlignment="Stretch"
                                  Visibility="Collapsed"
                                  Background="{DynamicResource SplitterBrush}"/>

                    <!-- Script (collapsed by default) + last apply output -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Expander Grid.Row="0" Header="Script" FontWeight="SemiBold" FontSize="12"
                                  Style="{StaticResource SectionExpander}"
                                  ExpandDirection="Up"
                                  IsExpanded="{Binding ScriptPanelExpanded, Mode=TwoWay}"
                                  Expanded="ScriptExpander_Changed"
                                  Collapsed="ScriptExpander_Changed">
                            <TextBox Text="{Binding GeneratedScript, Mode=OneWay}"
                                     IsReadOnly="True" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     FontFamily="Consolas" FontSize="11" FontWeight="Normal"
                                     Padding="8"/>
                        </Expander>

                        <DockPanel Grid.Row="1"
                                   Visibility="{Binding HasLastApplyLog, Converter={StaticResource BoolToVis}}">
                            <Border DockPanel.Dock="Top" Background="{DynamicResource SectionHeaderBackgroundBrush}" Padding="8,4">
                                <TextBlock Text="Last apply output" FontWeight="SemiBold" FontSize="12"/>
                            </Border>
                            <TextBox Text="{Binding LastApplyLog, Mode=OneWay}"
                                     IsReadOnly="True" AcceptsReturn="True"
                                     MaxHeight="110"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     FontFamily="Consolas" FontSize="11"
                                     Padding="8"/>
                        </DockPanel>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Loading overlay (covers the tree + right panel area) -->
            <Grid Panel.ZIndex="20"
                  Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                Background="{DynamicResource OverlayBrush}">
                <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource DialogBackgroundBrush}" BorderBrush="{DynamicResource DialogBorderBrush}" BorderThickness="1"
                        Padding="28,16" CornerRadius="6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Loading…" FontSize="15" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

    </DockPanel>
</Window>
